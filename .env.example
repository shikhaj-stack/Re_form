# Database Connection (PostgreSQL or SQLite for local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reform_db?schema=public"

# Authentication Secrets
AUTH_SECRET="super-secret-jwt-key-min-32-chars-reform-b2b-secure"
NEXTAUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"

# Security & Rate Limiting
RATE_LIMIT_MAX_REQUESTS="60"
RATE_LIMIT_WINDOW_MS="60000"
